<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RedroBridgeMaker</AssemblyName>
    <RootNamespace>RedroBridgeMaker</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyInformationalVersion Condition="'$(InformationalVersion)' == ''">dev</AssemblyInformationalVersion>
  </PropertyGroup>
</Project>
