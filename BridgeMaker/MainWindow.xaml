<Window x:Class="RedroBridgeMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redro Bridge Maker | صانع الجسور" Width="1320" Height="850" MinWidth="1000" MinHeight="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
            <Canvas Width="58" Height="42" Margin="0,0,8,0">
                <Path Data="M 4,31 L 54,31 M 10,31 C 16,5 42,5 48,31" Stroke="#D94343" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="16" Y1="31" X2="16" Y2="38" Stroke="#333333" StrokeThickness="3" />
                <Line X1="42" Y1="31" X2="42" Y2="38" Stroke="#333333" StrokeThickness="3" />
            </Canvas>
            <StackPanel>
                <TextBlock Text="REDRO BRIDGE MAKER" FontSize="20" FontWeight="Bold" Foreground="#333333" />
                <TextBlock Text="صانع الجسور | Vector bridge placement" Foreground="#D94343" />
            </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Row="1">
            <Button Click="Open_Click">Open Corel / PDF / EPS / SVG | فتح ملف</Button>
            <Button Click="Auto_Click">Automatic Bridges | جسور تلقائية</Button>
            <Button x:Name="ManualButton" Click="Manual_Click">Manual: Off | يدوي: إيقاف</Button>
            <Button Click="Clear_Click">Clear | مسح</Button>
            <Button Click="Export_Click">Export SVG | تصدير</Button>
        </WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Text="Bridge length / طول الجسر" VerticalAlignment="Center" Margin="4,0,3,0" />
            <TextBox x:Name="BridgeLength" Width="60" Text="5" />
            <TextBlock Text="cm   Start offset / من البداية" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="StartOffset" Width="60" Text="2" />
            <TextBlock Text="cm   End offset / من النهاية" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="EndOffset" Width="60" Text="2" />
            <TextBlock Text="   Count / العدد" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="BridgeCount" Width="55" Text="0" ToolTip="0 = fill automatically / صفر = حساب تلقائي" />
            <TextBlock Text="   Spacing / المسافة" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="Spacing" Width="70" Text="100" ToolTip="Distance between bridge starts / المسافة بين بدايات الجسور" />
            <TextBlock Text="cm between starts / بين البدايات" VerticalAlignment="Center" Foreground="Gray" />
            <TextBlock Text="   Auto: leftover goes in center; 10 cm+ adds a bridge / التلقائي: الزائد بالنصف؛ 10 سم+ يضيف جسراً" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" />
        </WrapPanel>
        <WrapPanel Grid.Row="3" Margin="0,5,0,0" VerticalAlignment="Center">
            <TextBlock Text="Path / المسار:" VerticalAlignment="Center" Margin="4,0,4,0" />
            <ComboBox x:Name="PathSelector" Width="180" SelectionChanged="PathSelector_SelectionChanged" />
            <TextBlock Text="   Zoom / تكبير" VerticalAlignment="Center" Margin="14,0,5,0" />
            <Button Click="ZoomOut_Click" Padding="8,2">-</Button>
            <Slider x:Name="ZoomSlider" Width="150" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" />
            <Button Click="ZoomIn_Click" Padding="8,2">+</Button>
            <TextBlock x:Name="ZoomText" Text="100%" Width="55" VerticalAlignment="Center" Margin="5,0,0,0" />
            <TextBlock Text="Mouse wheel / عجلة الفأرة" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0" />
        </WrapPanel>
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Margin="0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Preview" Background="White" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseWheel="Preview_MouseWheel" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="5">
            <TextBlock x:Name="Dimensions" Margin="4,2,4,0" FontWeight="SemiBold" Text="Drawing dimensions / أبعاد الرسم: —" />
            <TextBlock x:Name="Status" Margin="4" Text="Open a file / افتح ملفاً للبدء." />
        </StackPanel>
    </Grid>
</Window>
