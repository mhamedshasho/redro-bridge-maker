<Window x:Class="RedroBridgeMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redro Bridge Maker | صانع الجسور" Width="1280" Height="800" MinWidth="980" MinHeight="620">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
            <Button Click="Open_Click">Open Corel / PDF / EPS / SVG | فتح ملف</Button>
            <Button Click="Auto_Click">Automatic Bridges | جسور تلقائية</Button>
            <Button x:Name="ManualButton" Click="Manual_Click">Manual: Off | يدوي: إيقاف</Button>
            <Button Click="Clear_Click">Clear | مسح</Button>
            <Button Click="Export_Click">Export SVG | تصدير</Button>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
            <TextBlock Text="Bridge length / طول الجسر" VerticalAlignment="Center" Margin="4,0,3,0" />
            <TextBox x:Name="BridgeLength" Width="60" Text="5" />
            <TextBlock Text="mm   Start offset / من البداية" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="StartOffset" Width="60" Text="2" />
            <TextBlock Text="mm   End offset / من النهاية" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="EndOffset" Width="60" Text="2" />
            <TextBlock Text="mm   Count / العدد" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="BridgeCount" Width="55" Text="0" ToolTip="0 = fill automatically / صفر = حساب تلقائي" />
            <TextBlock Text="   Spacing / المسافة" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="Spacing" Width="70" Text="100" ToolTip="Distance between bridge starts / المسافة بين بدايات الجسور" />
            <TextBlock Text="mm between starts / بين البدايات" VerticalAlignment="Center" Foreground="Gray" />
        </WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,5,0,0" VerticalAlignment="Center">
            <TextBlock Text="Zoom / تكبير" VerticalAlignment="Center" Margin="4,0,5,0" />
            <Button Click="ZoomOut_Click" Padding="8,2">-</Button>
            <Slider x:Name="ZoomSlider" Width="150" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" />
            <Button Click="ZoomIn_Click" Padding="8,2">+</Button>
            <TextBlock x:Name="ZoomText" Text="100%" Width="55" VerticalAlignment="Center" Margin="5,0,0,0" />
            <TextBlock Text="Mouse wheel also zooms / عجلة الفأرة للتكبير" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0" />
        </WrapPanel>
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Preview" Background="White" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseWheel="Preview_MouseWheel" />
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="4" x:Name="Status" Margin="4" Text="Open a file / افتح ملفاً للبدء." />
    </Grid>
</Window>
