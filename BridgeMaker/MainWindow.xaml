<Window x:Class="RedroBridgeMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redro Bridge Maker" Width="1200" Height="760" MinWidth="900" MinHeight="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
            <Button Click="Open_Click">Open Corel / PDF / EPS / SVG</Button>
            <Button Click="Auto_Click">Automatic Bridges</Button>
            <Button x:Name="ManualButton" Click="Manual_Click">Manual Bridge: Off</Button>
            <Button Click="Clear_Click">Clear Bridges</Button>
            <Button Click="Export_Click">Export SVG</Button>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
            <TextBlock Text="Bridge length" VerticalAlignment="Center" Margin="4,0,3,0" />
            <TextBox x:Name="BridgeLength" Width="65" Text="5" />
            <TextBlock Text="mm   Start offset" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="StartOffset" Width="65" Text="2" />
            <TextBlock Text="mm   End offset" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="EndOffset" Width="65" Text="2" />
            <TextBlock Text="mm   Spacing" VerticalAlignment="Center" Margin="8,0,3,0" />
            <TextBox x:Name="Spacing" Width="75" Text="100" />
            <TextBlock Text="mm (automatic)" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="Gray" />
        </WrapPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Preview" Background="White" MouseLeftButtonDown="Preview_MouseLeftButtonDown" />
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="3" x:Name="Status" Margin="4" Text="Open a CorelDRAW, PDF, EPS or SVG vector file to start." />
    </Grid>
</Window>
