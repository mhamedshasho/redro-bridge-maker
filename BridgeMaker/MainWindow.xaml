<Window x:Class="RedroBridgeMaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Redro Bridge Maker" Width="1200" Height="760" MinWidth="900" MinHeight="600">
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel>
<Button Click="Open_Click">Open PDF / EPS / SVG</Button><Button Click="Auto_Click">Automatic Bridges</Button><Button Click="Manual_Click">Manual Bridge</Button><Button Click="Clear_Click">Clear Bridges</Button><Button Click="Export_Click">Export SVG</Button>
<TextBlock Text="Bridge" VerticalAlignment="Center" Margin="15,0,3,0"/><TextBox x:Name="BridgeLength" Width="60" Text="5"/>
<TextBlock Text="mm   Start" VerticalAlignment="Center"/><TextBox x:Name="StartOffset" Width="60" Text="2"/>
<TextBlock Text="mm   End" VerticalAlignment="Center"/><TextBox x:Name="EndOffset" Width="60" Text="2"/>
<TextBlock Text="mm   Spacing" VerticalAlignment="Center"/><TextBox x:Name="Spacing" Width="70" Text="100"/>
</WrapPanel>
<Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,8"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="Preview"/></ScrollViewer></Border>
<TextBlock Grid.Row="2" x:Name="Status" Margin="4" Text="Open a vector file to start."/>
</Grid></Window>